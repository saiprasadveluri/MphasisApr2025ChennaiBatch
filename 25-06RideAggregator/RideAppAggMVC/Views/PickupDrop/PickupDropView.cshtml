@model List<PickupDropDTO>
@{
    ViewBag.Title = "PickupDrop List";
}
<h2>PickupDrop List</h2>


<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>PickupDrop Id</th>
            <th>Driver Id</th>
            <th>Customer Id</th>
            <th>PickupLocation Id</th>
            <th>DropLocation Id</th>
            <th>Pickup Time</th>
            <th>Drop Time</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var pickupdrop in Model)
        {
            <tr>
                <td>@pickupdrop.pId</td>
                <td>@pickupdrop.dId</td>
                <td>@pickupdrop.cId</td>
                <td>@pickupdrop.pickupLocationId</td>
                <td>@pickupdrop.dropLocationId</td>
                <td>@pickupdrop.pickupTime</td>
                <td>@pickupdrop.dropTime</td>
            </tr>
        }
    </tbody>
</table>
