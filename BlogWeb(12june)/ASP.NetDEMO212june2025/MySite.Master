               <div style="width:20%;height:500px;background-color:gray;padding:30px;">
                   <table>
                       <tr>
                           <td>
                               <a href="/ViewBlogPosts.aspx">View BlogPosts</a>
                           </td>
                       </tr>
                        <tr>
                         <td>
