@model JobSearchDatabase.Data.JobPosting

@{
    ViewData["Title"] = "Delete Job Posting";
}

<h1>Delete Job Posting</h1>

<h3>Are you sure you want to delete this job posting?</h3>

<div>
    <dl class="row">
        <dt class="col-sm-2">Job Posting ID</dt>
        <dd class="col-sm-10">@Model.JobPostingId</dd>

        <dt class="col-sm-2">Job Title</dt>
        <dd class="col-sm-10">@Model.JobTitle</dd>

        <dt class="col-sm-2">Employer ID</dt>
        <dd class="col-sm-10">@Model.EmployerId</dd>

        <dt class="col-sm-2">Category ID</dt>
        <dd class="col-sm-10">@Model.CategoryId</dd>

        <dt class="col-sm-2">Posted Date</dt>
        <dd class="col-sm-10">@Model.PostedDate.ToString("yyyy-MM-dd")</dd>

        <dt class="col-sm-2">Is Active</dt>
        <dd class="col-sm-10">@Model.IsActive</dd>
    </dl>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="JobPostingId" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
