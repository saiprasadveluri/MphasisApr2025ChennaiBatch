@model JobSearchDatabase.Data.CandidateSkills

@{
    ViewData["Title"] = "Edit Candidate Skill";
}

<h3>Edit Candidate Skill</h3>

<form asp-action="Edit">
    <input type="hidden" asp-for="CandidateId" />
    <div class="form-group">
        <label asp-for="SkillId" class="control-label"></label>
        <input asp-for="SkillId" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="SkillLevel" class="control-label"></label>
        <select asp-for="SkillLevel" class="form-control"
                asp-items="Html.GetEnumSelectList<JobSearchDatabase.EnumsJob.SkillLevel>()"></select>
    </div>
    <div class="form-group">
        <label asp-for="IsPrimary" class="control-label"></label>
        <input asp-for="IsPrimary" class="form-control" />
    </div>
    <input type="submit" value="Save" class="btn btn-primary" />
    <a asp-action="Index">Back to List</a>
</form>
