@model IEnumerable<JobSearchDatabase.Data.CandidateSkills>

@{
    ViewData["Title"] = "Candidate Skills";
}

<div class="candhead">
    <div>
        <h3>CandidateSkills</h3>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-success">Create New CandidateSkills</a>
    </div>
</div>

<table class="table table-hover table-bordered" style="background-color:white;">
    <thead class="table-active">
        <tr>
            <th>CandidateId</th>
            <th>SkillId</th>
            <th>SkillLevel</th>
            <th>IsPrimary</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.CandidateId</td>
                <td>@item.SkillId</td>
                <td>@item.SkillLevel</td>
                <td>@item.IsPrimary</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.CandidateId" class="btn btn-primary btn-sm">Edit</a>
                    <a asp-action="Delete" asp-route-id="@item.CandidateId" class="btn btn-danger btn-sm">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
