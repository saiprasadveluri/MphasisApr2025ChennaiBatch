@model JobSearchDatabase.Data.CandidateSkills

@{
    ViewData["Title"] = "Delete Candidate Skill";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>

<div>
    <h4>Candidate Skill</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">CandidateId</dt>
        <dd class="col-sm-10">@Model.CandidateId</dd>

        <dt class="col-sm-2">SkillId</dt>
        <dd class="col-sm-10">@Model.SkillId</dd>

        <dt class="col-sm-2">SkillLevel</dt>
        <dd class="col-sm-10">@Model.SkillLevel</dd>

        <dt class="col-sm-2">IsPrimary</dt>
        <dd class="col-sm-10">@Model.IsPrimary</dd>
    </dl>

    <form asp-action="DeleteConfirmed">
        <input type="hidden" asp-for="CandidateId" />
        <input type="submit" value="Delete" class="btn btn-danger" />
        <a asp-action="Index">Back to List</a>
    </form>
</div>
