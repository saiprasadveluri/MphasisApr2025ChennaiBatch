@model JobSearchDatabase.Data.Employer

@{
    ViewData["Title"] = "Delete Employer";
}

<h3>Delete Employer</h3>

<h6>Are you sure you want to delete this?</h6>
<hr />

<div>
    <h4>@Model.CompanyName</h4>
    <dl class="row">
        <dt class="col-sm-2">Employer Name :</dt>
        <dd class="col-sm-10">@Model.EmployerName</dd>

        <dt class="col-sm-2">Designation :</dt>
        <dd class="col-sm-10">@Model.Designation</dd>
    </dl>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="EmployerId" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
