@model JobSearchDatabase.Data.JobApplicationDTO

@{
    ViewData["Title"] = "Delete Job Application";
}

<h1>Delete Confirmation</h1>

<h3>Are you sure you want to delete this?</h3>

<div>
    <h4>Job Application</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Job Posting</dt>
        <dd class="col-sm-10">@Model.JobPosting?.JobTitle</dd>

        <dt class="col-sm-2">Candidate</dt>
        <dd class="col-sm-10">@Model.Candidate?.FirstName @Model.Candidate?.LastName</dd>

        <dt class="col-sm-2">Applied Date</dt>
        <dd class="col-sm-10">@Model.AppliedDate.ToString("yyyy-MM-dd")</dd>

        <dt class="col-sm-2">Status</dt>
        <dd class="col-sm-10">@Model.Status</dd>
    </dl>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="ApplicationId" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
