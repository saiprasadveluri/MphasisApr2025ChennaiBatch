@model IEnumerable<JobSearchDatabase.Data.Skill>

@{
    ViewData["Title"] = "Skills";
}

<div class="candhead">
    <div>
        <h3>Skills</h3>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-success">Create New Skill</a>
    </div>
</div>

<table class="table table-hover table-bordered" style="background-color:white;">
    <thead class="table-active">
        <tr>
            <th>Skill Name</th>
            <th>Skill Category</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var skill in Model)
        {
            <tr>
                <td>@skill.SkillName</td>
                <td>@skill.SkillCategory</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@skill.SkillId" class="btn btn-primary btn-sm">Edit</a>
                    <a asp-action="Delete" asp-route-id="@skill.SkillId" class="btn btn-danger btn-sm">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
