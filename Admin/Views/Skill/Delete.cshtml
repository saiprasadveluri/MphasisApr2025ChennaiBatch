@model JobSearchDatabase.Data.Skill

@{
    ViewData["Title"] = "Delete Skill";
}

<h3>Delete Skill</h3>

<h6>Are you sure you want to delete this?</h6>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Skill Name :</dt>
        <dd class="col-sm-10">@Model.SkillName</dd>

        <dt class="col-sm-2">Skill Category :</dt>
        <dd class="col-sm-10">@Model.SkillCategory</dd>
    </dl>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="SkillId" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
