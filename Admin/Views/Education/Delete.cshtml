@model JobSearchDatabase.Data.Education

@{
    ViewData["Title"] = "Delete Education";
}

<h3>@ViewData["Title"]</h3>

<h6>Are you sure you want to delete this?</h6>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Institution :</dt>
        <dd class="col-sm-10">@Model.Institution</dd>

        <dt class="col-sm-2">Degree :</dt>
        <dd class="col-sm-10">@Model.Degree</dd>

        <dt class="col-sm-2">Field Of Study :</dt>
        <dd class="col-sm-10">@Model.FieldOfStudy</dd>

        <dt class="col-sm-2">Start Date :</dt>
        <dd class="col-sm-10">@Model.StartDate.ToShortDateString()</dd>

        <dt class="col-sm-2">End Date :</dt>
        <dd class="col-sm-10">@Model.EndDate.ToShortDateString()</dd>

        <dt class="col-sm-2">Is Current :</dt>
        <dd class="col-sm-10">@Model.IsCurrent</dd>
    </dl>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="EducationId" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
