@model IEnumerable<JobSearchDatabase.Data.Candidate>

@{
    ViewData["Title"] = "Candidates";
}

<div class="candhead">
    <div>
        <h3>Candidates</h3>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-success">Create New Candidate</a>
    </div>
</div>

<table class="table table-hover table-bordered" style="background-color:white;">
    <thead class="table-active">
        <tr>
            <th>Candidate ID</th>
            <th>User ID</th>
            <th style="white-space: nowrap;">First Name</th>
            <th style="white-space: nowrap;">Last Name</th>
            <th style="padding-right: 79px;">DoB</th>
            <th>Gender</th>
            <th>Address</th>
            <th>Resume File Path</th>
            <th style="white-space: nowrap;">Profile Summary</th>
            <th class="actbtn">Actions</th> 
        </tr>
    </thead>
    <tbody>
        @foreach (var candidate in Model)
        {
            <tr>
                <td>@candidate.CandidateId</td>
                <td>@candidate.UserId</td> 
                <td>@candidate.FirstName</td>
                <td>@candidate.LastName</td>
                <td>@candidate.DateOfBirth.ToString("yyyy-MM-dd")</td>
                <td>@candidate.Gender</td>
                <td>@candidate.Address</td>
                <td>@candidate.ResumeFilePath</td>
                <td>@candidate.ProfileSummary</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@candidate.CandidateId" class="btn btn-primary btn-sm">Edit</a>
                    <a asp-action="Delete" asp-route-id="@candidate.CandidateId" class="btn btn-danger btn-sm">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>


