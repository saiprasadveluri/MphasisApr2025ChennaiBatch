@model JobSearchDatabase.Data.WorkExperience
@{
    ViewData["Title"] = "Delete Work Experience";
}

<h3>Delete Work Experience</h3>

<h6>Are you sure you want to delete this?</h6>
<hr />

<dl class="row">
    <dt class="col-sm-2">Company</dt>
    <dd class="col-sm-10">@Model.CompanyName</dd>

    <dt class="col-sm-2">Job Title</dt>
    <dd class="col-sm-10">@Model.JobTitle</dd>

    <dt class="col-sm-2">Period</dt>
    <dd class="col-sm-10">@Model.StartDate – @Model.EndDate</dd>
</dl>

<form asp-action="Delete" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="WorkExperienceId" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>