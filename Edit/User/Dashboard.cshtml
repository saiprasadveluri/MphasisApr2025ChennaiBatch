@using OnlineQuiZMVC.DTO
@model AccountUserDTO
<div class="d-flex" style="min-height:100vh;">
    <!-- Sidebar -->
    <aside class="bg-light p-3 border-end" style="width:220px;">
        <h5 class="mb-3">Navigation</h5>
        <ul class="nav flex-column">
            <li class="nav-item"><a class="nav-link" href="#">📈 Track Progress</a></li>
            <li class="nav-item"><a class="nav-link" href="#">📝 Take Quiz</a></li>
            <li class="nav-item"><a class="nav-link" href="#">📊 View Scores</a></li>
        </ul>
    </aside>

    <!-- Main Content -->
    <main class="flex-fill p-4">
        <div class="d-flex justify-content-end mb-3">
            <!-- User Profile Dropdown -->
            <div class="dropdown">
                <button class="btn btn-secondary dropdown-toggle" data-bs-toggle="dropdown">
                    @Model.UserName
                </button>
                <div class="dropdown-menu dropdown-menu-end p-3" style="min-width:300px;">
                    <p><strong>Email:</strong> @Model.Email</p>
                    <p><strong>Password:</strong> ******</p>
                    <p><strong>Contact:</strong> @Model.ContactNo</p>
                    <div class="d-flex justify-content-between">
                        <a href="/User/Edit" class="btn btn-sm btn-primary">Edit</a>
                        <a href="/Account/Logout" class="btn btn-sm btn-danger">Logout</a>
                    </div>
                </div>
            </div>
        </div>

        <h3>Welcome, @Model.UserName!</h3>
        <p>Select an option from the left to get started.</p>
    </main>
</div>
