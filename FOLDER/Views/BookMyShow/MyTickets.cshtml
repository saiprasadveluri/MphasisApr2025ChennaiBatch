@model  List<BookMyShow.Models.Booking> 

<div class="container mt-5">


            <div class="card">
                <div class="card-header"   style="background-color: #ff3c58;" >
                    Your Ticket Status
                </div>
                <div class="card-body">
                   
                <h1 style=" color: #dc3545;    font-size: 1 rem;font-weight: bold;text-align: center;">
                    YOUR BOOKING HAS BE CANCELLED !
                </h1>
                 
            </div>
            </div>
        

    </div>

    <style>
        /* Custom styles for this specific component */
        .container {
            max-width: 600px;
        }
        .card {
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
            background-color: #fff;
        }
        .card-header {
            background-color: #007bff;
            color: white;
            font-size: 1.8rem;
            font-weight: bold;
            text-align: center;
            border-top-left-radius: 12px;
            border-top-right-radius: 12px;
            padding: 20px;
        }
       
    </style>