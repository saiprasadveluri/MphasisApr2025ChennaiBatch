@model BookMyShow.Models.User

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

<style>
    body {
        background-color: white;
    }

    .forgot-container {
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: flex-start;
        padding-top: 2rem;
    }

    .forgot-card {
        background: #fff;
        padding: 2.5rem 2rem;
        border-radius: 1rem;
        box-shadow: 0 0 20px rgba(0, 0, 0, 0.15);
        width: 100%;
        max-width: 500px;
        color: #000;
    }

    .form-title {
        color: #dc3545;
        font-weight: bold;
        text-align: center;
        margin-bottom: 2rem;
    }

    .form-control, .form-select {
        background-color: #fff;
        border: 1px solid #ced4da;
        color: #000;
    }

    .text-danger, .text-success {
        font-weight: 500;
    }
</style>

<div class="forgot-container">
    <div class="forgot-card">
        <h2 class="form-title">Forgot Password</h2>
        <form method="post">
            <div class="mb-3">
                <label asp-for="Email" class="form-label">Email</label>
                <input type="text" asp-for="Email" class="form-control" placeholder="Enter your email" required />
            </div>
            <div class="mb-3">
                <label asp-for="Security_Question" class="form-label">Security Question</label>
                <select asp-for="Security_Question" asp-items="ViewBag.SecurityQuestions" class="form-select">
                    <option value="">-- Select a security question --</option>
                </select>
            </div>
            <div class="mb-3">
                <label asp-for="Security_Answer" class="form-label">Security Answer</label>
                <input type="text" asp-for="Security_Answer" class="form-control" placeholder="Your answer" required />
            </div>
            <div class="mb-3">
                <label class="form-label">New Password</label>
                <input type="password" name="Pass" class="form-control" placeholder="New password" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Confirm Password</label>
                <input type="password" name="confirmpass" class="form-control" placeholder="Confirm password" required />
            </div>
            <div class="d-grid">
                <button type="submit" class="btn btn-danger btn-lg">Change Password</button>
            </div>
            @if (!string.IsNullOrEmpty(ViewBag.err as string))
            {
                <div class="text-danger text-center mt-3">@ViewBag.err</div>
            }
            @if ((int?)ViewBag.update > 0)
            {
                <div class="text-success text-center mt-3">Password updated successfully.</div>
                <a href="/BookMyShow/Login" class="btn btn-link mt-3" style="text-decoration: underline; color: #dc3545; font-weight: bold;">Login</a>
            }
        </form>
    </div>
</div>
