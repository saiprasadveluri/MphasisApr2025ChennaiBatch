@model List<BookMyShow.Models.Movie>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<style>
    .poster-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 32px;
        justify-content: flex-start;
        padding: 40px 0;
    }

    .poster-card {
        background: #232323;
        border-radius: 12px;
        box-shadow: 4px 16px rgba(0,0,0,0.2);
        width: 220px;
        transition: transform 0.2s;
        position: relative;
    }

        .poster-card:hover {
            transform: scale(1.08);
            box-shadow: none;
            cursor: pointer;
        }

    .poster-img {
        width: 100%;
        height: 330px;
        object-fit: cover;
        display: block;
        background: #333;
    }

    .poster-title {
        color: #fff;
        font-size: 1.1rem;
        font-weight: 600;
        margin: 16px 12px 8px 12px;
        text-align: center;
    }
</style>
<!-- Carousel -->
<div class="mt-3">
</div>
<div id="movieCarousel" class="carousel slide mb-5 mx-auto" data-bs-ride="carousel" style="width:1400px;height:300px">
    <div class="carousel-inner">
        <div class="carousel-item active">
            <img src="/poster1.jpeg" class="d-block w-100" alt="First slide" style="height:300px; object-fill;">
        </div>
        <div class="carousel-item">
            <img src="/poster2.jpeg" class="d-block w-100" alt="Second slide" style="height: 300px; object-fit: fill;">
        </div>
        <div class="carousel-item">
            <img src="/poster3.jpeg" class="d-block w-100" alt="Third slide" style="height: 300px; object-fit: fill;">
        </div>
    </div>
    <button class="carousel-control-prev" type="button" data-bs-target="#movieCarousel" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Previous</span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#movieCarousel" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Next</span>
    </button>
</div>

<!-- Movie Cards -->
<h2 class="container-fluid" style="margin-inline-start:200px;padding-inline-start:50px" ">Recommended Movies</h2>
<div class="container-fluid mb-5 d-flex" style="padding-inline-start:50px;margin-inline-start:200px">
    <div class="poster-grid">
        @foreach (var movie in Model)
        {
            <div class="poster-card">
                <img class="poster-img" src="data:image/jpeg;base64,@Convert.ToBase64String(movie.MoviePoster)" alt="@movie.MovieName Poster" />
                <div class="poster-title">@movie.MovieName</div>
            </div>
        }
    </div>
</div>
