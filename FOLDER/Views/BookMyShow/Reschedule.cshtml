@model BookMyShow.Models.Booking

@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}

<div class="container">
    <h2>Reschedule Booking #@Model.BookId</h2>

    <div class="current-booking">
        <p>Movie: @Model.Movie.MovieName</p>
        <p>Current Show: @Model.ShowTime</p>
    </div>

    <form method="post">
        <input type="hidden" name="bookingId" value="@Model.BookId" />

        <div class="form-group">
            <label>New Showtime:</label>
            <select name="newShowId" class="form-control">
                @foreach (var show in ViewBag.AvailableShows)
                {
                    <option value="@show.ShowId">@show.Timings</option>
                }
            </select>
        </div>

        <button type="submit" class="btn btn-primary">Confirm Reschedule</button>
    </form>
</div>