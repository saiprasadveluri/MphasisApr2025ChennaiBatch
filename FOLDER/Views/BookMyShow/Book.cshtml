<div class="d-flex justify-content-center align-items-center"  style="background-color: white;">
   <div class="d-flex justify-content-center align-items-center">
    

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            <ul class="mb-0">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
        </div>
    }

   </div>
    <div >
        <!-- ✅ Left Container: Seat Selection (30%) -->
         
        <div class="p-2 border rounded text-center mt-3" style="width: 60%; background-color: #1a1a1a; color: white;">
               <h2 class="text-center mb-2" style="color: #ff3c58;">Book Your Seats</h2>
            <form method="post" asp-action="Book" asp-controller="BookMyShow">
                <input type="hidden" name="showId" value="@ViewBag.ShowId" />
                <input type="hidden" name="theaterId" value="@ViewBag.TheaterId" />
                <input type="hidden" name="date" value="@ViewBag.Date" />
                <input type="hidden" id="seatPrice" value="@ViewBag.SeatPrice" />

                <label class="form-label fw-bold text-white text-center">Select Seat:</label>
                <div class="seating-layout d-flex flex-wrap">
                    @if (availableSeats != null && availableSeats.Length > 0)
                    {
                        var normalizedBookedSeats = (bookedSeats ?? Array.Empty<string>())
                        .Select(s => s.Trim().ToLowerInvariant())
                        .ToArray();

                        @foreach (var seat in availableSeats)
                        {
                            var normalizedSeat = seat.Trim().ToLowerInvariant();
                            var isBooked = normalizedBookedSeats.Contains(normalizedSeat);
                            <div class="seat-container m-1">
                                <input type="checkbox" name="selectedSeats" value="@seat" id="@seat"
                                       @(isBooked ? "disabled" : "") class="seat-checkbox d-none" />
                                <label class="seat-label @(isBooked ? "disabled-seat" : "")" for="@seat" title="@seat">
                                    <img src="~/images/@(isBooked ? "seat-booked.png" : "seat-available.png")" alt="Seat" width="40" height="40" />
                                </label>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted text-center ">No seats available at the moment.</p>
                    }
                </div>

                <div class="screen text-center mt-4">
                    <img src="~/images/screen.png" alt="Screen" class="img-fluid" style="max-width: 200px;" />
                    <p class="text-muted mt-2">Screen This Way</p>
                </div>

                <div class="text-center mt-4">
                    <button type="submit" class="btn px-2 py-2" style="background-color: #ff3c58; color: white;">Select Seat</button>
                </div>
            </form>
        </div>

        <!-- ✅ Right Container: Summary (60%) -->
       <div class="p-2 border rounded text-center mt-3" style="width: 60%; background-color: #1a1a1a; color: white;">
    <h4 class="mb-3" style="color: #ff3c58;">Booking Summary</h4>

    @if (TempData["SeatCount"] != null && int.TryParse(TempData["SeatCount"].ToString(), out var seatCount) && seatCount > 0)
    {
   
        @if (TempData["Message"] != null)
        {
            <div class="alert alert-success text-dark fw-bold bg-white">
                @TempData["Message"]
            </div>
        }

        <div class="mb-2 text-center">
            <strong>Seats Selected:</strong> @seatCount
        </div>
        <div class="mb-4 text-center">
            <strong>Total Amount:</strong> ₹@TempData["TotalAmount"]
        </div>

        <form method="get" asp-action="Payment">
            <input type="hidden" name="showId" value="@ViewBag.ShowId" />
            <input type="hidden" name="theaterId" value="@ViewBag.TheaterId" />
            <input type="hidden" name="date" value="@ViewBag.Date" />
            <input type="hidden" name="SeatNumbers" value="@TempData["SeatNumbers"]" />
            
            <button type="submit" class="btn w-50" style="background-color: #ff3c58; color: white;"> Book </button>
        </form>
    }
    else
    {
    
        <div  style="color:white; font-weight:bolder">No seats selected yet.</div>
    }
</div>

    </div>
</div>

<style>
    body {
        background-color: #FFF;
    }


    .seating-layout {
        max-width: 100%;
    }

    .btn:focus {
        box-shadow: none;
    }

</style>



<script>
    document.querySelectorAll('.seat-checkbox').forEach(function(checkbox) {
        checkbox.addEventListener('change', function() {
            var label = checkbox.nextElementSibling;
            var img = label.querySelector('img');
            if (checkbox.checked) {
                img.src = '@Url.Content("~/images/seat-selected.png")';
            } else {
                img.src = '@Url.Content("~/images/seat-available.png")';
            }
        });
    });


    function handleClick(e) {
          e.preventDefault(); // ✅ Prevents the form from submitting immediately
          console.log("Button clicked!"); // ✅ Corrected from Console.Write to console.log

          // You can add any custom logic here before submitting
          // For example, validation or confirmation

          // ✅ Submit the form manually if needed
          e.target.closest("form").submit();

           const seatPrice = @ViewBag.SeatPrice;
           console.log("Seat" , seatPrice);
      } 


</script>

