@model BookMyShow.Models.Admin
@using AspNetCore.ReCaptcha
@{
    Layout = "/Views/Shared/WithoutSearch.cshtml";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
<style>
    body {
        background: white;
    }

    .register-container {
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: flex-start;
        padding-top: 1rem;
    }

    .register-card {
        background: #fff;
        padding: 3rem 2rem;
        border-radius: 1rem;
        box-shadow: 0 0 30px rgba(0, 0, 0, 0.1);
        width: 100%;
        max-width: 700px;
    }

    .form-title {
        color: black;
        font-weight: 600;
        text-align: center;
        margin-bottom: 2rem;
    }

    .captcha-box {
        font-weight: bold;
        font-size: 1.25rem;
        color: black;
        background-color: #f8f9fa;
        letter-spacing: 3px;
        text-align: center;
        border: 1px solid #ced4da;
        border-radius: 0.5rem;
        padding: 0.5rem;
        margin-bottom: 0.5rem;
        user-select: none;
    }
</style>
<div class="register-container mt-5">
    <div class="register-card">
        <h2 style="color: #ff3c58;"  class="form-title">Create Your Account</h2>
        <form asp-action="AdminRegister" method="post" enctype="multipart/form-data" novalidate>
            <div class="row mb-3">
                <div class="col-md-6">
                    <label name="Username" class="form-label">Admin Name</label>
                    <input name="Username" class="form-control" />

                </div>
                <div class="col-md-6">
                    <label name="Password" class="form-label">Password</label>
                    <input name="Password" type="password" class="form-control" />

                </div>
            </div>
            <div class="row mb-4">
                <div class="col-md-6">
                    <label class="form-label">Captcha</label>
                    <div class="captcha-box">
                        @ViewBag.CaptchaCode
                    </div>
                    <input name="Captcha" class="form-control" autocomplete="off" />
                    @* <span asp-validation-for="Captcha" class="text-danger"></span> *@
                </div>
            </div>
            <div class="d-grid">
                <button type="submit" style="background-color: #ff3c58;"  class="btn">Register</button>
            </div>

            <div>
                @if (ViewBag.success != null)
                {
                    <div class="alert alert-success alert-dismissible" style="max-width:600px;">
                        <strong>@ViewBag.success</strong>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
            </div>
        </form>
    </div>
</div>
