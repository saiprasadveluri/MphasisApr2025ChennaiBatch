@{
}
@model IEnumerable<Host>
<h1>Host Data</h1>
<table class="table">
    <thead>
        <tr>
            <th>HostId</th>
            <th>HostName</th>
            <th>EmpNumber</th>
            <th>Department</th>
            <th>Location</th>
            <th>Phone</th>
        </tr>
    </thead>
    <tbody>
            @foreach(var item in Model)
            {
            <tr>
                <td>@item.HostId</td>
                <td>@item.HostName</td>
                <td>@item.EmpNumber</td>
                <td>@item.Department</td>
                <td>@item.LocationId</td>
                <td>@item.Phone</td>
            </tr>
            }
    </tbody>
</table>

