@model BookMVC.Models.RegisterModel

<h2>Register</h2>

<form asp-action="Register" method="post">
    <input asp-for="Username" placeholder="Username" required />
    <input asp-for="Email" placeholder="Email" required />
    <input asp-for="Password" type="password" placeholder="Password" required />
    <select asp-for="Role">
        <option value="User">User</option>
        <option value="Admin">Admin</option>
    </select>

    <partial name="_CaptchaPartial" />

    <button type="submit">Register</button>
</form>

