@using RideAggregatorMVC.DTO;
@model GetAllCustomers;
<h1>Customer</h1>
<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Customer Id</th>
            <th>Login Id</th>
            <th>Customer Name</th>
            <th>Contact No</th>
        </tr>
    </thead>
    <tbody>
        @foreach (CustomerDTO customerDTO in Model.data)
        {
            <tr>
                <td>@customerDTO.cusId</td>
                <td>@customerDTO.loginID</td>
                <td>@customerDTO.cusName</td>
                <td>@customerDTO.contactNo</td>
            </tr>
        }
    </tbody>
</table>
