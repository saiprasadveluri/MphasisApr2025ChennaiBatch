@model List<(string Title, string Controller)>

@{
    ViewData["Title"] = "Dashboard";
}

<h3 class="dashh3">Dashboard</h3>

<div class="row">
    @foreach (var card in Model)
    {
        <div class="col-md-3 mb-4">
            <a asp-controller="@card.Controller" asp-action="Index" style="text-decoration:none; color: inherit;">
                <div class="card h-100 shadow-sm">
                    <div class="card-body d-flex flex-column justify-content-center align-items-center cards">
                        <h5 class="card-title">@card.Title</h5>
                    </div>
                </div>
            </a>
        </div>

    }
</div>
