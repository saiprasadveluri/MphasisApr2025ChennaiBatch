@model BookMyShow.Models.User

@{
    Layout = "WithoutSearch";
    ViewData["Title"] = "Edit Profile";
}

<style>
    body {
        background: white;
    }

    .container {
        max-width: 700px;
        margin: 2rem auto;
        background: #fff;
        padding: 2.5rem 2rem;
        border-radius: 1rem;
        box-shadow: 0 0 30px rgba(0, 0, 0, 0.1);
    }

    h5 {
        font-weight: 600;
        color: black;
        text-align: center;
        margin-bottom: 2rem;
    }

    .form-label {
        margin-bottom: 0.2rem;
        font-weight: 600;
        color: black;
    }

    .form-control,
    .form-control-static,
    .form-text {
        margin-bottom: 0.3rem;
    }

    .mb-3 {
        margin-bottom: 0.7rem !important;
    }

    .btn {
        margin-right: 0.3rem;
    }

    .img-thumbnail {
        max-width: 100px;
        max-height: 100px;
    }

    .form-check-inline {
        margin-right: 1rem;
    }

    .form-control-static {
        padding: 0.375rem 0.75rem;
        background-color: #e9ecef;
        border: 1px solid #ced4da;
        border-radius: 0.25rem;
        display: inline-block;
        width: 100%;
    }

    .form-title {
        color: black;
        font-weight: 600;
        text-align: center;
        margin-bottom: 2rem;
    }

    .form-text {
        font-size: 0.875em;
        color: #6c757d;
    }
</style>

<div class="container">
    <h2 class="form-title">Update Profile</h2>

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">@ViewBag.ErrorMessage</div>
    }
    <form method="post" enctype="multipart/form-data" novalidate>
        <div class="mb-3">
            <label class="form-label">Username:</label>
            <p class="form-control-static">@Model.Username</p>
            <input type="hidden" name="_username" value="@Model.Username" />
        </div>

        <div class="mb-3">
            <label for="FullName" class="form-label">Full Name:</label>
            <input type="text" id="FullName" name="FullName" placeholder="Name" class="form-control" value="@Model.FullName" />
            @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger" })
        </div>

        <div class="mb-3">
            <label for="Age" class="form-label">Age:</label>
            <input type="number" id="Age" name="Age" placeholder="Age" class="form-control" value="@Model.Age" />
            @Html.ValidationMessageFor(m => m.Age, "", new { @class = "text-danger" })
        </div>

        <div class="mb-3">
            <label for="Email" class="form-label">Email:</label>
            <input type="email" id="Email" name="Email" placeholder="Email" class="form-control" value="@Model.Email" />
            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
        </div>

        <div class="mb-3">
            <label for="MobileNo" class="form-label">Mobile Number:</label>
            <input type="tel" id="MobileNo" name="MobileNo" placeholder="Mobile Number" class="form-control" value="@Model.MobileNo" />
            @Html.ValidationMessageFor(m => m.MobileNo, "", new { @class = "text-danger" })
        </div>

        <div class="mb-3">
            <label for="Address" class="form-label">Address:</label>
            <input type="text" id="Address" name="Address" placeholder="Address" class="form-control" value="@Model.Address" />
            @Html.ValidationMessageFor(m => m.Address, "", new { @class = "text-danger" })
        </div>

        <div class="mb-3">
            <label for="Pic" class="form-label">Profile Picture:</label>
            <input type="file" id="Pic" name="Pic" class="form-control" accept="image/*" />
            @if (Model.ProfilePic != null && Model.ProfilePic.Length > 0)
            {
                var base64 = Convert.ToBase64String(Model.ProfilePic);
                var imgSrc = $"data:image/gif;base64,{base64}";
                <img src="@imgSrc" alt="Current Profile Pic" class="img-thumbnail mt-2" />
                <small class="form-text">Upload a new image to replace the current one.</small>
            }
            else
            {
                <small class="form-text">No profile picture uploaded yet.</small>
            }
            @Html.ValidationMessageFor(m => m.ProfilePic, "", new { @class = "text-danger" })
        </div>

        <div class="d-grid">
            <button type="submit" style="background-color: #ff3c58;" class="btn btn-lg">Update Profile</button>
            <a href="@Url.Action("UpdateProfile", "BookMyShow")" class="btn btn-secondary btn-lg mt-2">Cancel</a>
        </div>
    </form>
</div>
