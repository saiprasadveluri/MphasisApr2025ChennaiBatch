@model List<BookMyShow.Models.Review>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Movie Details - @ViewBag.name</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <style>
        body {
            margin: 0;
            font-family: 'Segoe UI', Arial, sans-serif;
            background: #121212;
            color: #fff;
        }

        .movie-banner {
            position: relative;
            background-size: cover;
            padding: 60px 40px;
            display: flex;
            gap: 40px;
            align-items: center;
        }

        .poster-img {
            width: 250px;
            border-radius: 10px;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);
        }

        .movie-info-box {
            flex: 1;
        }

        .movie-title {
            font-size: 2.5rem;
            font-weight: bold;
        }

        .badge {
            background-color: #444;
            color: white;
            margin-right: 6px;
        }

        .book-btn {
            background-color: #ff3c58;
            border: none;
            color: white;
            font-size: 1.1rem;
            padding: 10px 30px;
            border-radius: 6px;
            margin-top: 20px;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

            a:hover, a:focus {
                color: inherit;
                text-decoration: none;
            }

        .about-section {
            background: white;
            color: black;
            padding: 10px 40px 10px 40px;
        }

        .about-section2 {
            background: white;
            color: black;
            padding: 10px 40px 10px 40px;
        }

        .about-section h2 {
            font-weight: bold;
            font-size: 1.8rem;
            margin-bottom: 20px;
        }

        .movie-meta {
            margin-top: 16px;
            font-size: 1rem;
        }

            .movie-meta span {
                display: inline-block;
                margin-right: 16px;
                color: #ccc;
            }
    </style>
</head>
<body>
    <div class="movie-banner">
       @if (ViewBag.image != null)
        {
            <img src="data:image/jpeg;base64,@Convert.ToBase64String((byte[])ViewBag.image)" alt="@ViewBag.name Poster" class="poster-img" />
        }
        else
        {
            <img src="~/images/default-poster.jpg" alt="No poster available" class="poster-img" />
        }
        <div class="movie-info-box">
            <div class="movie-title">@ViewBag.name</div>
            @if (ViewBag.language != null)
            {
                <div class="mt-3">
                    @foreach (var lan in (List<string>)ViewBag.language)
                    {
                        <span class="badge">@lan</span>
                    }
                </div>
            }
            <div class="movie-meta mt-3">
                <span>@ViewBag.duration</span>
                <span>@ViewBag.genre</span>
                <span>@ViewBag.release</span>
            </div>
            <div class="mt-4">
                <a href="@Url.Action("Theatre", "BookMyShow", new { id = ViewBag.id })" class="book-btn">Book tickets</a>
            </div>
        </div>
    </div>

    <div class="about-section">
        <h2>About the movie</h2>
        <p>@ViewBag.desc</p>
    </div>
    <div class="about-section2">
        <h2>Cast</h2>
        @if (ViewBag.Cast == null)
        {
            <p>No cast information available.</p>

        }
        else
        {
            @foreach (MovieCast cast in ViewBag.Cast)
            {
                <div class="row">
                    <div class="col">
                        <div class="card shadow-sm text-center p-3">
                            <div class="fw-bold">Actor</div>
                            <div>@cast.Actor</div>
                        </div>
                    </div>
                    <div class="col">
                        <div class="card shadow-sm text-center p-3">
                            <div class="fw-bold">Actress</div>
                            <div>@cast.Actress</div>
                        </div>
                    </div>
                    <div class="col">
                        <div class="card shadow-sm text-center p-3">
                            <div class="fw-bold">Director</div>
                            <div>@cast.Director</div>
                        </div>
                    </div>
                    <div class="col">
                        <div class="card shadow-sm text-center p-3">
                            <div class="fw-bold">Producer</div>
                            <div>@cast.Producer</div>
                        </div>
                    </div>
                    <div class="col">
                        <div class="card shadow-sm text-center p-3">
                            <div class="fw-bold">Musician</div>
                            <div>@cast.Musician</div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
    @if (ViewBag.related == null || ((List<Movie>)ViewBag.related).Count == 0)
    {
        <div class="about-section2">
            <h2>You Might Also Like</h2>
            <p>No Reccomedation.</p>
        </div>
    }
    else
    {
        <div class="about-section2">
            <h2>You Might Also Like</h2>
            <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-4">
                @foreach (Movie movie in ViewBag.related)
                {
                    <div class="col-md-4 col-12">
                        <a href="@Url.Action("MovieDetail", "User",
                                     new {  id = movie.MovieId,
                                            name = movie.MovieName,
                                            duration = movie.Duration,
                                            desc = movie.Description,
                                            release = movie.ReleaseDate
                                     })">
                            @* <img class="poster-img" src="data:image/jpeg;base64,@Convert.ToBase64String(movie.MoviePoster)" alt="@movie.MovieName Poster" /> *@
                            @if (ViewBag.image != null && ((byte[])ViewBag.image).Length > 0) 
{
    <img src="data:image/jpeg;base64,@Convert.ToBase64String((byte[])ViewBag.image)" alt="@ViewBag.name Poster" class="poster-img" />
}
else
{
    <img src="~/images/default-poster.jpg" alt="No poster available" class="poster-img" />
}

                        </a>
                    </div>
                }
            </div>
        </div>
    }
    <div class="about-section2">
        <h2>Top Reviews</h2>
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var r in (List<Review>)ViewBag.review)
            {
                <div class="col">
                    <div class="card shadow-sm h-100">
                        <div class="card-body">
                            <div class="mb-2">
                                <strong>Comment:</strong>
                                <div>@r.CommentText</div>
                            </div>
                            <div class="mb-2">
                                <strong>Rating:</strong>
                                @{
                                    int rating_count = Convert.ToInt32(r.Rating);
                                }
                                @for (int i = 0; i < rating_count; i++)
                                {
                                    <span style="color: #ff3c58;">&#9733;</span>
                                }
                                @for (int i = rating_count; i < 5; i++)
                                {
                                    <span style="color: #ccc;">&#9733;</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    @* Review Section *@
    <div class="about-section2">
        <div class="shadow-sm" style="width:500px">
            <h2>Leave a review</h2>
            <form method="post" class="p-4 rounded" style="max-width: 500px; margin: 0 0;">
                <input type="text" value="@ViewBag.id" name="movieid" hidden />
                <div class="mb-3">
                    <label class="form-label text-dark">Rating</label>
                    <div class="star-rating" style="font-size: 2rem; direction: rtl;">
                        <input type="radio" id="star5" name="Rating" value="5" required /><label for="star5" title="5 stars" style="cursor:pointer;">&#9733;</label>
                        <input type="radio" id="star4" name="Rating" value="4" /><label for="star4" title="4 stars" style="cursor:pointer;">&#9733;</label>
                        <input type="radio" id="star3" name="Rating" value="3" /><label for="star3" title="3 stars" style="cursor:pointer;">&#9733;</label>
                        <input type="radio" id="star2" name="Rating" value="2" /><label for="star2" title="2 stars" style="cursor:pointer;">&#9733;</label>
                        <input type="radio" id="star1" name="Rating" value="1" /><label for="star1" title="1 star" style="cursor:pointer;">&#9733;</label>
                    </div>
                </div>
                <style>
                    .star-rating 
                    {
                        unicode-bidi: bidi-override;
                        direction: rtl;
                        display: inline-flex;
                        gap: 0.2em;
                    }

                        .star-rating input[type="radio"] 
                        {
                            display: none;
                        }

                        .star-rating label 
                        {
                            color: #ccc;
                            transition: color 0.2s;
                        }

                            .star-rating input[type="radio"]:checked ~ label,
                            .star-rating label:hover,
                            .star-rating label:hover ~ label 
                            {
                                color: #ff3c58;
                            }
                </style>
                <div class="mb-3">
                    <label class="form-label text-dark">Comment</label>
                    <textarea name="Comment" class="form-control" rows="3" placeholder="Write your comment..." required></textarea>
                </div>
                <div class="mb-3">
                    <label class="form-label text-dark me-3">Your Reaction:</label>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="Radio" value="1" required>
                        <label class="form-check-label text-dark" for="likeRadio">&#128077</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="Radio" value="0">
                        <label class="form-check-label text-dark" for="dislikeRadio">&#128078</label>
                    </div>
                </div>
                <div class="text-center mt-3">
                    <button type="submit" class="btn btn-danger px-4" onclick="Message()">Submit</button>
                </div>
            </form>
        </div>
    </div>
</body>
</html>
@if (ViewBag.errr != null)
{
    <div class="alert alert-danger alert-dismissible" style="max-width: 600px;">
        <strong>@ViewBag.errr </strong>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
