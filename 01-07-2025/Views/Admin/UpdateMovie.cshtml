@using Microsoft.Extensions.Primitives
@{
    Layout = "~/Views/Shared/AdminLayout.cshtml";
}
@{
    var cities = ViewBag.Cities as List<City>;
    var theaternames = ViewBag.Theaternames as List<TheaterName>;
    var selectedCity = ViewBag.SelectedCity as int?;
}
<div class="container mt-4 shadow-lg p-4 rounded" style="margin-top:100px; max-width: 600px;">

    <h2 class="text-center mt-4">Update Movie Details</h2>
    <form asp-action="UpdateMovie" method="get">

        <label class="fw-bold">Select City</label>
        <select name="cityId" onchange="this.form.submit()" class="form-control">
            <option value="">-- Select City --</option>
            @foreach (var city in cities)
            {
                <option value="@city.CityId" selected="@(selectedCity == city.CityId ? "selected" : null)">
                    @city.CityName
                </option>
            }
        </select>
    </form>

    <form method="post">
        <div class="mb-3">
            <div class="mb-3">
                <label class="mb-2 fw-bold">Select Theaters </label><br />
                <select name="tname" class="form-control">
                    <option>-- Select Theater --</option>
                    @foreach (var tn in theaternames)
                    {

                        <option value="@tn.Theatername1">
                            @tn.Theatername1
                        </option>
                    }
                </select>
            </div>
            <label class="fw-bold">Enter Movie Name</label>
            <input type="text" class="form-control mb-3" placeholder="Enter Movie Name" name="mname" required />
            <label class="fw-bold">Enter Movie Price</label>
            <input type="text" class="form-control mb-3" placeholder="Enter Movie Price" name="mprice" required />
            <span class="fw-bold">Upload New Movie Poster</span> <input type="file" name="poster" accept="image/*" class="form-control mt-3" />
        </div>
        <div class="mb-3">
            <label class="form-label">Show Timings (e.g., 09:00 AM)</label><br />
            <input class="form-check-input mb-3" type="checkbox" name="show" value="10:30 AM" />10:30 AM
            <br />  <input class="form-check-input mb-3" type="checkbox" name="show" value="2:00 PM" />2:00 PM
            <br /> <input class="form-check-input mb-3" type="checkbox" name="show" value="6:30 PM" />6:30 PM
        </div>
        <input type="submit" style="background-color: #ff3c58;" class="btn  w-100" value="Update To Theater" />
    </form>
    <a href="@Url.Action("Home", "Admin")"  class="btn btn-danger text-decoration-none mt-3 w-100">Back to home page</a>
</div>
@if (ViewBag.updatesucess != null)
{
    <div class="alert alert-success alert-dismissible" style="max-width:600px;">
        <strong>@ViewBag.updatesucess</strong>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (ViewBag.updatefail != null)
{
    <div class="alert alert-danger alert-dismissible" style="max-width:600px;">
        <strong>@ViewBag.updatefail </strong>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
