            <div class="col ">
                    <div class="card dashboard-card h-100 text-center p-3 " style="background-color:#ff3c58">
                    <div class="card-body ">
                            <h5 class="card-title mb-3 text-white">No. of Movies <br /> @ViewBag.movies</h5>
