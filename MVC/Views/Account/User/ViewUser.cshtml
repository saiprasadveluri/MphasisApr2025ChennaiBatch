@using OnlinePharmacyApp.DTO
@model GetUsers
<h1>List of Users</h1>
<table class="table table-striped">
    <thead>
        <tr>
            <th>UserId</th>
            <th>Username</th>
            <th>Email</th>
            <th>Password</th>
            <th>PhoneNumber</th>
            <th>Address</th>
            <th>IsAdmin</th>
        </tr>
    </thead>
    <tbody>
        @foreach (UserDTO user in Model.data)
        {
            <tr>
                <td>@user.userId</td>
                <td>@user.userName</td>
                <td>@user.email</td>
                <td>@user.password</td>
                <td>@user.address</td>
                <td>@user.isAdmin</td>

            </tr>
        }
    </tbody>
</table>
