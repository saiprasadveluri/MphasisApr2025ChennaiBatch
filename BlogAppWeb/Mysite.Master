<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Mysite.master.cs" Inherits="BlogAppWeb.Mysite" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <title></title>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <div style="display:flex;flex-direction:column">
            <div style="width:100%;height:100px;background-color:aqua">
               <span color="black"> Header-Logo here</span>
            </div>
            <div style="width:100%;height:500px; display:flex;flex-direction:row">
                <div style="width:20%;height:500px;background-color:gray">
                    Left Nav link
                    <table>
                        <tr>
                            <td>
                                <a href="ViewPost.aspx">View Blog Post</a>
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <a href="AddBlogpost.aspx">Add Blog Post</a>
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <a href="ViewBlogComment.aspx">View Comments List</a>
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <a href="AddComment.aspx">Add Comments</a>
                            </td>
                        </tr>
                    </table>


                </div>
                <div style="width:80%;height:500px;background-color:lightcoral">
                    <div>
                        <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
                        </asp:ContentPlaceHolder>
                    </div>
                     
                </div>

            </div>
            <div style="width:100%;height:50px;background-color:burlywood">
                Footer
            </div>

        </div>
        <div>
           
        </div>
    </form>
</body>
</html>
