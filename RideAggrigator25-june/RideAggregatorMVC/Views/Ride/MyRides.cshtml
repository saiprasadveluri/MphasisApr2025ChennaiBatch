@model IEnumerable<RideAggregatorMVC.Models.Ride>
@foreach (var ride in Model)
{
    <tr>
        <td>@ride.PickupLocation</td>
        <td>@ride.DropLocation</td>
        <td>@ride.RideDate.ToShortDateString()</td>
        <td>@(ride.IsCompleted ? "Completed" : "In Progress")</td>
        <td>
            @if (!ride.IsCompleted)
            {
                <form asp-action="EndRide" method="post">
                    <input type="hidden" name="rideId" value="@ride.Id" />
                    <button type="submit" class="btn btn-warning">Complete Ride</button>
                </form>
            }
            else
            {
                <span class="text-success">✔ Ride Completed</span>
            }
        </td>
    </tr>
}
