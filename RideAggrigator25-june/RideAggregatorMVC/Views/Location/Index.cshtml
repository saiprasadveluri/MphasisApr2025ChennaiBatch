@model IEnumerable<RideAggregatorMVC.Models.Location>

<h2>Locations</h2>

<a asp-action="Create" class="btn btn-primary mb-3">Add Location</a>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var loc in Model)
        {
            <tr>
                <td>@loc.Id</td>
                <td>@loc.Name</td>
            </tr>
        }
    </tbody>
</table>