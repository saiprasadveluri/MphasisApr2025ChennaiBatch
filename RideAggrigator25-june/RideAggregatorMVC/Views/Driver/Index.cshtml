@model List<RideAggregatorMVC.Models.Driver>

<h2>Driver List</h2>
<a asp-action="Create">Add New Driver</a>
<table class="table">
    <thead>
        <tr><th>Name</th><th>Email</th><th>Phone</th><th>License</th><th>Vehicle</th></tr>
    </thead>
    <tbody>
        @foreach (var d in Model)
        {
            <tr>
                <td>@d.Name</td>
                <td>@d.Email</td>
                <td>@d.Phone</td>
                <td>@d.LicenseNumber</td>
                <td>@d.VehicleDetails</td>
            </tr>
        }
    </tbody>
</table>
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}
