@model List<LocationDTO>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Location Id</th>
            <th>Location Name</th>
        </tr>
    </thead>
    <tbody>
            @foreach (LocationDTO loc in Model)
            {
            <tr>
                <td>@loc.locationId</td>
                <td>@loc.locationName</td>
            </tr>
            }
        
    </tbody>
</table>
