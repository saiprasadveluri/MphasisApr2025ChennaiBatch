                <div style="width:80%;height:500px;background-color:darkolivegreen">
                    <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
                    </asp:ContentPlaceHolder>
    `           </div>
            </div>
            <div style="display:flex;flex-direction:column;width:100%;height:100px;background-color:darkslateblue">
                Footer logo
            </div>
        </div>
    </form>
