                <span style="color:white">Header logo</span>
            </div>
            <div style="width:100%;height:500px;display:flex;flex-direction:row;background-color:blueviolet">
                <div style="width:20%;height:500px;background-color:cornflowerblue">
                    <table>
                        <tr><td><a href="Add.aspx">AddBlogPost</a></td></tr>
                        <tr><td><a href="View.aspx">ViewBlogPost</a></td></tr>
                        <tr><td><a href="AddComment.aspx">AddComment</a></td></tr>
                        <tr><td><a href="ViewComment.aspx">ViewComment</a></td></tr>
                    </table>
