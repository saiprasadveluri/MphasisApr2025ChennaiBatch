<form method="post" asp-action="Login" class="form-control" style="padding-bottom:20px">
    <table style="padding:200px">
        <tr>
            <td><label id="txt">Email:</label></td>
            <td><input id="email" name="email" /></td>
        </tr>
        <tr>
            <td><label id="txtP">Password:</label></td>
            <td><input id="pwd" name="password" type="password" /></td>
        </tr>
        <tr>
        <td><label>Role:</label></td>
        <td>
        <select name="role">
        <option disabled selected>Select Role</option>
        <option value="Admin">Admin</option>
        <option value="Customer">Customer</option>
        <option value="Driver">Driver</option>
        </select>
        </td>
        </tr> 
        <tr>
            <td colspan="2">
                <button type="submit">Login</button>
            </td>
        </tr>

    </table>
</form>