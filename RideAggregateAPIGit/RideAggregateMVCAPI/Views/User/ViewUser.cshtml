@using RideAggregateMVCAPI.DTO;
@model GetAllUsers
<h2>Users</h2>

<table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>Email</th>
          
            <th>Role</th>
        </tr>
    </thead>
    <tbody>
        @foreach (UserDTOM user in Model.data)
        {
            <tr>
                <td>@user.userId</td>
                <td>@user.userEmail</td>
             
                <td>@user.userRole</td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="Create" class="btn btn-primary">Add New User</a>
