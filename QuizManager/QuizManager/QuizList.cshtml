@using OnlineQuizApp.DTO
@model List<QuizListDTO>

@{
    Layout = "~/Views/Shared/AdminDashboard.cshtml";
}

<style>
    .quiz-table-wrapper {
        margin: 40px auto;
        max-width: 1000px;
        background-color: #fff;
        border-radius: 10px;
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.1);
        padding: 30px;
    }

    .quiz-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
    }

    .quiz-title {
        font-size: 1.8rem;
        font-weight: 700;
        color: #198754;
    }

    .create-btn {
        background-color: #198754;
        color: #fff;
        padding: 10px 25px;
        font-weight: 600;
        border-radius: 30px;
        border: none;
        transition: background-color 0.3s ease;
    }

        .create-btn:hover {
            background-color: #157347;
        }

    .table thead {
        background-color: #198754;
        color: white;
        font-size: 1rem;
    }

    .table tbody tr {
        background-color: #f8f9fa;
    }

    .table th, .table td {
        vertical-align: middle;
        padding: 15px;
    }

    .btn-edit, .btn-delete {
        border-radius: 20px;
        padding: 6px 16px;
        font-weight: 600;
        margin-right: 6px;
    }

    .btn-edit {
        background-color: #0d6efd;
        color: white;
    }

        .btn-edit:hover {
            background-color: #0b5ed7;
        }

    .btn-delete {
        background-color: #dc3545;
        color: white;
    }

        .btn-delete:hover {
            background-color: #bb2d3b;
        }
</style>

<div class="quiz-table-wrapper">
    <div class="quiz-header">
        <h3 class="quiz-title">📋 Quiz Manager</h3>
        <a asp-action="AddNewQuiz" class="create-btn">
            <i class="bi bi-plus-circle me-2"></i>Create New Quiz
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-bordered text-center align-middle">
            <thead>
                <tr>
                    <th>Quiz Title</th>
                    <th>Category</th>
                    <th>Duration (mins)</th>
                    <th>Scheduled Time</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var quiz in Model)
                    {
                        <tr>
                            <td>@quiz.QuizTitle</td>
                            <td>@quiz.Category</td>
                            <td>@quiz.Duration</td>
                            <td>
                                @if (quiz.ScheduledTime.HasValue)
                                {
                                    @quiz.ScheduledTime.Value.ToString("dd MMM yyyy, hh:mm tt")
                                }
                                else
                                {
                                    <span class="text-muted">Not Scheduled</span>
                                }
                            </td>
                            <td>
                                <a asp-action="EditQuiz" asp-route-id="@quiz.QuizId" class="btn btn-edit">
                                    <i class="bi bi-pencil-square me-1"></i> Edit
                                </a>
                                <a asp-action="DeleteQuiz" asp-route-id="@quiz.QuizId" class="btn btn-delete" onclick="return confirm('Are you sure you want to delete this quiz?');">
                                    <i class="bi bi-trash3-fill me-1"></i> Delete
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted">No quizzes available. Please create one.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>