@using OnlineQuizApp.DTO
@model QuizListDTO;

@{
    Layout = "~/Views/Shared/AdminDashboard.cshtml";
}
@section Scripts {
    <script>
        function toggleSchedule() {
            const checkbox = document.getElementById('IsScheduled');
            const scheduleDiv = document.getElementById('scheduleTimeDiv');
            scheduleDiv.style.display = checkbox.checked ? 'flex' : 'none';
        }

        document.addEventListener("DOMContentLoaded", toggleSchedule);
    </script>
}

<style>
    .form-wrapper {
        margin-top: 40px;
        display: flex;
        justify-content: center;
    }

    .form-card {
        width: 100%;
        max-width: 700px;
        background-color: #fff;
        border-radius: 10px;
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.1);
        padding: 30px 25px;
    }

    .form-title {
        font-size: 1.8rem;
        font-weight: 700;
        text-align: center;
        color: #198754;
        margin-bottom: 25px;
    }

    .form-group {
        display: flex;
        align-items: center;
        margin-bottom: 20px;
    }

    .form-label {
        width: 30%;
        font-weight: 600;
        font-size: 1rem;
        margin-right: 10px;
        text-align: right;
    }

    .form-control {
        width: 70%;
        font-size: 1rem;
        height: 38px;
        padding: 6px 10px;
    }

    .text-danger {
        font-size: 0.9rem;
        margin-left: 32%;
        margin-top: 3px;
        display: block;
    }

    .btn-green {
        background-color: #28a745;
        color: white;
        padding: 10px 30px;
        font-size: 1.05rem;
        font-weight: 600;
        border: none;
        transition: background-color 0.3s ease;
    }

        .btn-green:hover {
            background-color: #218838;
        }
</style>

<div class="form-wrapper">
    <div class="form-card">
        <h3 class="form-title">Create New Quiz</h3>

        <form asp-action="CreateQuiz" method="post">
            <div class="form-group">
                <label asp-for="QuizTitle" class="form-label">Quiz Title</label>
                <input asp-for="QuizTitle" class="form-control" />
            </div>
            <span asp-validation-for="QuizTitle" class="text-danger"></span>

            <div class="form-group">
                <label asp-for="Category" class="form-label">Category</label>
                <input asp-for="Category" class="form-control" />
            </div>
            <span asp-validation-for="Category" class="text-danger"></span>

            <div class="form-group">
                <label asp-for="Duration" class="form-label">Duration (minutes)</label>
                <input asp-for="Duration" class="form-control" type="number" />
            </div>
            <span asp-validation-for="Duration" class="text-danger"></span>

            <div class="form-group">
                <label class="form-label">Schedule?</label>
                <input asp-for="IsScheduled" type="checkbox" class="form-check-input ms-2" onchange="toggleSchedule()" id="IsScheduled" />
            </div>

            <div class="form-group" id="scheduleTimeDiv" style="display: none;">
                <label asp-for="ScheduledTime" class="form-label">Scheduled Time</label>
                <input asp-for="ScheduledTime" type="datetime-local" class="form-control" />
                <span asp-validation-for="ScheduledTime" class="text-danger"></span>
            </div>

            <div class="form-group mt-4">
                <label class="form-label"></label>
                <button type="submit" class="btn btn-green">Create Quiz</button>
            </div>
        </form>
    </div>
</div>