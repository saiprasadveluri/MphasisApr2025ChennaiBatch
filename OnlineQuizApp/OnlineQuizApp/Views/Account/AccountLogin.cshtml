@using OnlineQuizApp.DTO
@model RegisterViewModeldto
<div class="d-flex justify-content-center align-items-center"
     style="min-height:90%">
     <div class="bg-white p-4 box-shadow" 
      style="width:350px;">
      <h3 class="text-center mb-4">Sign In </h3>
      <form method="post">
          <div class="mb-3">
              <label asp-for="Email" class="form-label"> Email ID </label>
              <input asp-for="Email" class="form-control"/> 
              <span asp-validation-for="Email" class="text-danger"></span>
              <label class="form-label">Password</label>
              <input asp-for="Password" class="form-control"/>
              <span asp-validation-for="Password" class="text-danger"></span>
          </div>
           <div class="mb-3">
               <label class="form-label">Enter Captcha</label>
               <div class="d-flex align-items-center">
                   <strong style="font-family:monospace;font-size:20px;background:#f1f1f1;padding:5px 10px;border:1px solid #ccc;">
                        @Model.CaptchaOutput
                   </strong>
                   @* <button type="submit" class="btn btn-link btn sm" formaction="/AccountLogin">retry</button> *@
                   </div>
                <input asp-for="CaptchaInput" class="form-control mt-2" />
                <span asp-validation-for="CaptchaInput" class="text-danger"></span> 
               
           </div> 
          @* <div class="mb-3">
              <label class="form-label">Role</label>
              <select class="form-select" name="role">
                  <option value="">select role</option>
                  <option>Admin</option>
                  <option>User</option>
              </select>
          </div> *@
          <div class="form-check mb-3">
              <input class="form-check-input" type="checkbox"name="notRobot" />
              <label class="form-check-label" for="notRobot"></label>
               I am not a Robot
          </div>
          <button type ="submit" class="btn-primary w-100">Sign In</button>
          <div class="text-center">
              <a href="Register">Don't have a Account ? Register</a>
          </div>
      </form>

</div>
   