@model List<RideDTO>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Ride Id</th>
            <th>PickUp Id</th>
            <th>Distance</th>
            <th>Cost Per Km</th>
        </tr>
    </thead>
    <tbody>
        @foreach (RideDTO pic in Model)
        {
            <tr>
                <td>@pic.rideId</td>
                <td>@pic.pId</td>
                <td>@pic.distance</td>
                <td>@pic.costPerKm</td>
            </tr>
        }
    </tbody>
</table>
