@model List<UserDTO>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>User Id</th>
            <th>Email</th>
            <th>Password</th>
            <th>Role</th>
        </tr>
    </thead>
    <tbody>
        @foreach (UserDTO user in Model)
        {
            <tr>
                <td>@user.userId</td>
                <td>@user.email</td>
                <td>@user.password</td>
                <td>@user.role</td>
            </tr>
        }

    </tbody>
</table>

