<form method="post" asp-action="Login" class="form-control">
    <table>
        <tr>
            <td><label id="txt">Email:</label></td>
            <td><input id="email" name="email" /></td>
        </tr>
        <tr>
            <td><label id="txtP">Password:</label></td>
            <td><input id="pwd" name="password" type="password" /></td>
        </tr>
        <tr>
            <td colspan="2">
                <button type="submit">Login</button>
            </td>
        </tr>

    </table>
</form>
