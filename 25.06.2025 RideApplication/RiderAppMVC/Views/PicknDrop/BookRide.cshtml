@model PickUpDropDTO

@using (Html.BeginForm("BookRide", "PickUpDrop", FormMethod.Post))
{
    @Html.AntiForgeryToken()

    <div class="form-group">
        <label asp-for="driverId"></label>
        <input asp-for="driverId" class="form-control" />
        <span asp-validation-for="driverId" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="custId"></label>
        <input asp-for="custId" class="form-control" />
        <span asp-validation-for="custId" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="pickLocId"></label>
        <input asp-for="pickLocId" class="form-control" />
        <span asp-validation-for="pickLocId" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="dropLocId"></label>
        <input asp-for="dropLocId" class="form-control" />
        <span asp-validation-for="dropLocId" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="pickUpTime"></label>
        <input asp-for="pickUpTime" type="datetime-local" class="form-control" />
        <span asp-validation-for="pickUpTime" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="dropTime"></label>
        <input asp-for="dropTime" type="datetime-local" class="form-control" />
        <span asp-validation-for="dropTime" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Book</button>
}
