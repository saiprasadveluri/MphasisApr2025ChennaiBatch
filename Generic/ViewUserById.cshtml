@model JobSearchMVC.DataDTO.UserDTO


    <div class="table-container">
        <h3 class="text-center mb-4">Registered Users</h3>
        <table class="table table-bordered table-hover">
            <thead>
                <tr>
                    <th>User Id</th>
                    <th>User Name</th>
                    <th>Email</th>
                    <th>Password</th>
                    <th>Phone Number</th>
                    <th>Registration Date</th>
                    <th>Is Active</th>
                    <th>User Role</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                    <tr>
                        <td>@Model.userId</td>
                        <td>@Model.userName</td>
                        <td>@Model.email</td>
                        <td>@Model.password</td>
                        <td>@Model.phoneNumber</td>
                        <td>@Model.registrationDate.ToString("dd-MM-yyyy")</td>
                        <td>
                            <span class="badge bg-@(Model.isActive ? "success" : "secondary")">
                                @(Model.isActive ? "Active" : "Inactive")
                            </span>
                        </td>
                        <td>@Model.userRole</td>
                    </tr>
            </tbody>
        </table>
</div>