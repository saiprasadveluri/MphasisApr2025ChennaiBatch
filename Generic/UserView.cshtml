@using JobSearchMVC.DataDTO
@model IEnumerable<UserDTO>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<style>
    .table-container {
        margin: 30px auto;
        max-width: 90%;
    }

    .table th {
        background-color:cornflowerblue;
        color: #fff;
        text-align: center;
    }

    .table td {
        vertical-align: middle;
        text-align: center;
    }

    .table-striped tbody tr:nth-of-type(odd) {
        background-color: #f8f9fa;
    }

    .table-hover tbody tr:hover {
        background-color: #e2e6ea;
    }

    .table-bordered {
        border-color: #dee2e6;
    }
</style>

<div class="table-container">
    <h3 class="text-center mb-4">Registered Users</h3>
    <table class="table table-bordered table-hover">
        <thead>
            <tr>
                <th>User Id</th>
                <th>User Name</th>
                <th>Email</th>
                <th>Password</th>
                <th>Phone Number</th>
                <th>Registration Date</th>
                <th>Is Active</th>
                <th>User Role</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.userId</td>
                    <td>@user.userName</td>
                    <td>@user.email</td>
                    @* <td>@user.password</td> *@
                    <td><i class="bi bi-lock-fill">Hidden</i></td>
                    <td>@user.phoneNumber</td>
                    <td>@user.registrationDate.ToString("dd-MM-yyyy")</td>
                    <td>
                        <span class="badge bg-@(user.isActive ? "success" : "secondary")">
                            @(user.isActive ? "Active" : "Inactive")
                        </span>
                    </td>
                    <td>@user.userRole</td>
                    <td>
                        @Html.ActionLink("Edit", "EditUser", new { id = user.userId }, new { @class = "btn btn-sm btn-warning me-2" })
                        @Html.AntiForgeryToken()
                        <form asp-action="DeleteUser" asp-route-id="@user.userId" method="post" class="d-inline delete-form">
                            <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                        </form>

                    </td>

                </tr>
            }
        </tbody>
    </table>
</div>
