@using RoomManagerMVCApp.DTO
@model LoginInfoDTO
<h2>User Login</h2>
<hr/>
<div class="row">
    <div class="col-lg-12">
        <form method="post">
            <div>
                @Html.TextBoxFor(m=>m.Email,new {@class="form-control", type="email",placeholder="Enter email"})
            </div>
            <div>
                @Html.TextBoxFor(m => m.Password, new { @class = "form-control", type = "password", placeholder = "Enter Password" })
            </div>
            <div>
                <input type="submit" value="Login" />
            </div>
        </form>
    </div>
</div>