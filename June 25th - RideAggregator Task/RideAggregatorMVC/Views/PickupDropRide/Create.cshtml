@model RideAggregatorMVC.Models.PickupDropRide

<h2>Create PickupDropRide</h2>

<form asp-action="Create" method="post">
    <div class="form-group">
        <label asp-for="CustomerId"></label>
        <input asp-for="CustomerId" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="DriverId"></label>
        <input asp-for="DriverId" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="SourceLocationId"></label>
        <input asp-for="SourceLocationId" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="DestinationLocationId"></label>
        <input asp-for="DestinationLocationId" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="StartTime"></label>
        <input asp-for="StartTime" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="EndTime"></label>
        <input asp-for="EndTime" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="KmsTravelled"></label>
        <input asp-for="KmsTravelled" class="form-control" />
    </div>
    <br />
    <button type="submit" class="btn btn-primary">Create</button>
</form>

<a asp-action="Index" class="btn btn-secondary">Back to List</a>